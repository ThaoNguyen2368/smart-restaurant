# Smart Restaurant OS — Docker Environment
# Copy to .env: cp .env.example .env

# Database password for PostgreSQL container
DB_PASSWORD=dev_password_change_me

# JWT Secrets (change in production!)
JWT_SECRET=dev-jwt-secret-change-in-production-256bit
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production-256bit

# Public API URL baked into frontend Docker builds.
# Keep localhost for local Docker Compose. Use HTTPS API origin in staging/production.
PUBLIC_API_URL=http://localhost:8000/api

# Auto-confirm Mechanism
ORDER_REMINDER_MINUTES=3
ORDER_ESCALATION_MINUTES=5
AUTO_CONFIRM_ENABLED=False
