# Smart Restaurant OS — Docker Environment Variables
# Copy to .env: cp .env.example .env

# Database (PostgreSQL 15+ via Docker)
DB_PASSWORD=dev_password_change_me
DATABASE_URL=postgresql://app_user:dev_password_change_me@db:5432/smart_restaurant

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production-256bit
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production-256bit

# Redis
REDIS_URL=redis://redis:6379/0

# Environment
ENVIRONMENT=local

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:3005"]
